# Copy to your environment (or Vercel project settings). All are optional for local development.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma-separated. Vercel's deployment/production URLs are added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
# Extra allowed browser origins when the frontend is deployed separately on a custom domain.
CORS_ALLOWED_ORIGINS=

# Routing: osrm (default, keyless) | ors (truck profile, needs ORS_API_KEY) | estimate (offline)
ROUTING_PROVIDER=osrm
ORS_API_KEY=
TRUCK_MAX_SPEED_MPH=65
ROUTING_ALLOW_ESTIMATE_FALLBACK=1

# Geocoding: photon (default) | offline (bundled North American places index only)
GEOCODER=photon
